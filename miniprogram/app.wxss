/**app.wxss**/

page {
    min-height: 100vh;
    background: #F8F6F1;
    color: #202124;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    box-sizing: border-box;
  }
  
  /* 通用页面容器 */
  .container {
    min-height: 100vh;
    padding: 32rpx;
    box-sizing: border-box;
  }
  
  /* 去掉微信 button 默认样式 */
  button {
    background: initial;
    padding: 0;
    margin: 0;
    border-radius: 0;
    line-height: normal;
  }
  
  button:focus {
    outline: 0;
  }
  
  button::after {
    border: none;
  }
  
  /* 通用卡片 */
  .card {
    background: #FFFFFF;
    border-radius: 28rpx;
    padding: 28rpx;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 8rpx 24rpx rgba(41, 76, 96, 0.06);
    box-sizing: border-box;
  }
  
  /* 主按钮 */
  .primary-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    background: #294C60;
    color: #FFFFFF;
    border-radius: 24rpx;
    font-size: 30rpx;
    font-weight: 600;
    box-shadow: 0 12rpx 28rpx rgba(41, 76, 96, 0.18);
  }
  
  /* 次级按钮 */
  .secondary-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    background: #FFFFFF;
    color: #294C60;
    border-radius: 24rpx;
    font-size: 30rpx;
    font-weight: 600;
    border: 1rpx solid #E5E1DA;
  }
  
  /* 通用标签 */
  .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #DDECE7;
    color: #294C60;
    font-size: 24rpx;
    margin-right: 12rpx;
    margin-bottom: 12rpx;
  }
  
  /* 米色标签 */
  .tag-warm {
    background: #E9DED0;
    color: #7A4F2A;
  }
  
  /* 绿色标签 */
  .tag-green {
    background: #DDECE7;
    color: #294C60;
  }
  
  /* 灰色标签 */
  .tag-gray {
    background: #F1F0EC;
    color: #77746E;
  }
  
  /* 页面标题 */
  .page-title {
    font-size: 44rpx;
    font-weight: 800;
    color: #202124;
  }
  
  /* 页面副标题 */
  .page-subtitle {
    font-size: 26rpx;
    color: #77746E;
    margin-top: 8rpx;
  }
  
  /* 表单输入框 */
  .input-card {
    background: #FFFFFF;
    border-radius: 24rpx;
    border: 1rpx solid #E5E1DA;
    padding: 24rpx;
    box-sizing: border-box;
  }
  
  .input-label {
    font-size: 24rpx;
    color: #77746E;
    margin-bottom: 10rpx;
  }
  
  .input-value {
    font-size: 30rpx;
    color: #202124;
  }
  
  /* 底部安全距离 */
  .safe-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }