.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18rpx;
    margin-bottom: 28rpx;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 14rpx;
  }

  .merge-export-entry {
    height: 68rpx;
    line-height: 68rpx;
    padding: 0 24rpx;
    border-radius: 999rpx;
    background: #294C60;
    color: #FFFFFF;
    font-size: 24rpx;
    font-weight: 800;
    box-shadow: 0 6rpx 18rpx rgba(41, 76, 96, 0.14);
    white-space: nowrap;
  }
  
  .more {
    width: 68rpx;
    height: 68rpx;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    color: #294C60;
    font-size: 34rpx;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6rpx 18rpx rgba(41, 76, 96, 0.08);
  }
  
  .search-box {
    height: 88rpx;
    background: #FFFFFF;
    border-radius: 24rpx;
    border: 1rpx solid #E5E1DA;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
    margin-bottom: 18rpx;
    box-sizing: border-box;
  }
  
  .search-box input {
    flex: 1;
    font-size: 26rpx;
    color: #202124;
  }
  
  .search-icon {
    color: #77746E;
    margin-right: 12rpx;
    font-size: 30rpx;
  }

  .search-export-row {
    min-height: 72rpx;
    padding: 12rpx 18rpx;
    margin-bottom: 20rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14rpx;
    box-sizing: border-box;
  }

  .search-export-text {
    flex: 1;
    color: #77746E;
    font-size: 24rpx;
  }

  .search-export-btn {
    flex-shrink: 0;
    height: 52rpx;
    line-height: 52rpx;
    padding: 0 18rpx;
    border-radius: 999rpx;
    background: #DDECE7;
    color: #294C60;
    font-size: 23rpx;
    font-weight: 800;
  }

  .search-export-btn.disabled {
    opacity: 0.55;
  }
  
  .filter-row {
    display: flex;
    gap: 16rpx;
    margin-bottom: 32rpx;
    flex-wrap: wrap;
  }
  
  .filter {
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    color: #555;
    font-size: 24rpx;
    border: 1rpx solid #E5E1DA;
  }
  
  .filter.active {
    background: #294C60;
    color: #FFFFFF;
    border-color: #294C60;
  }
  
  .month-title {
    font-size: 28rpx;
    font-weight: 700;
    color: #77746E;
    margin-bottom: 18rpx;
  }
  
  .record-card {
    background: #FFFFFF;
    border-radius: 28rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 8rpx 24rpx rgba(41, 76, 96, 0.06);
  }
  
  .cover-wrap {
    position: relative;
    width: 100%;
    height: 260rpx;
    background: #E5E1DA;
  }
  
  .cover {
    width: 100%;
    height: 260rpx;
  }
  
  .cover-placeholder {
    height: 260rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #AAA49A;
    font-size: 26rpx;
    background: #F1F0EC;
  }
  
  .photo-count {
    position: absolute;
    right: 18rpx;
    top: 18rpx;
    background: rgba(32, 33, 36, 0.65);
    color: #FFFFFF;
    font-size: 22rpx;
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
  }
  
  .record-body {
    padding: 24rpx;
  }

  .record-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16rpx;
  }
  
  .record-title {
    flex: 1;
    font-size: 30rpx;
    font-weight: 700;
    color: #202124;
    line-height: 1.4;
    margin-bottom: 10rpx;
  }

  .privacy-badge {
    flex-shrink: 0;
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    background: #F8E6E0;
    color: #A23B2A;
    font-size: 21rpx;
    font-weight: 700;
  }
  
  .record-meta {
    font-size: 24rpx;
    color: #77746E;
    margin-bottom: 16rpx;
  }
  
  .proof-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
  }
  
  .proof-tag {
    background: #DDECE7;
    color: #294C60;
    border-radius: 999rpx;
    padding: 6rpx 16rpx;
    font-size: 22rpx;
  }

  .empty-guide {
    padding: 34rpx 28rpx 30rpx;
    border-radius: 28rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 8rpx 24rpx rgba(41, 76, 96, 0.06);
    margin-bottom: 24rpx;
  }

  .empty-guide-title {
    font-size: 32rpx;
    font-weight: 800;
    color: #202124;
    line-height: 1.35;
  }

  .empty-guide-desc {
    margin-top: 14rpx;
    color: #77746E;
    font-size: 25rpx;
    line-height: 1.65;
  }

  .onboarding-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 24rpx;
  }

  .onboarding-tag {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #F8F6F1;
    border: 1rpx solid #E5E1DA;
    color: #5F5A52;
    font-size: 23rpx;
  }

  .empty-guide-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 28rpx;
  }

  .primary-guide-btn,
  .secondary-guide-btn {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    border-radius: 999rpx;
    font-size: 25rpx;
    font-weight: 800;
  }

  .primary-guide-btn {
    background: #294C60;
    color: #FFFFFF;
    box-shadow: 0 8rpx 20rpx rgba(41, 76, 96, 0.16);
  }

  .secondary-guide-btn {
    background: #FFFFFF;
    color: #294C60;
    border: 1rpx solid #E5E1DA;
  }

  .example-card {
    padding: 28rpx;
    border-radius: 28rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 8rpx 24rpx rgba(41, 76, 96, 0.06);
    margin-bottom: 150rpx;
  }

  .example-card-head {
    display: flex;
    justify-content: space-between;
    gap: 20rpx;
    margin-bottom: 18rpx;
  }

  .example-title {
    font-size: 30rpx;
    font-weight: 800;
    color: #202124;
    line-height: 1.35;
  }

  .example-subtitle,
  .example-source {
    margin-top: 8rpx;
    color: #AAA49A;
    font-size: 22rpx;
  }

  .example-close {
    width: 52rpx;
    height: 52rpx;
    line-height: 50rpx;
    text-align: center;
    border-radius: 50%;
    background: #F8F6F1;
    color: #77746E;
    font-size: 34rpx;
    flex-shrink: 0;
  }

  .example-row {
    display: flex;
    gap: 18rpx;
    padding: 14rpx 0;
    border-top: 1rpx solid #F1F0EC;
    font-size: 24rpx;
    line-height: 1.5;
  }

  .example-label {
    width: 150rpx;
    flex-shrink: 0;
    color: #77746E;
  }

  .example-value {
    flex: 1;
    color: #202124;
    font-weight: 600;
  }

  .example-note {
    margin-top: 18rpx;
    padding: 20rpx;
    border-radius: 20rpx;
    background: #F8F6F1;
    color: #5F5A52;
    font-size: 24rpx;
    line-height: 1.6;
  }

  .example-actions {
    display: flex;
    gap: 16rpx;
    margin-top: 24rpx;
  }

  .example-primary-btn,
  .example-secondary-btn {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    border-radius: 999rpx;
    font-size: 24rpx;
    font-weight: 800;
  }

  .example-primary-btn {
    background: #294C60;
    color: #FFFFFF;
  }

  .example-secondary-btn {
    background: #FFFFFF;
    color: #294C60;
    border: 1rpx solid #E5E1DA;
  }

  .empty {
    padding: 46rpx 32rpx;
    border-radius: 28rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    text-align: center;
    color: #8a8178;
    margin-bottom: 150rpx;
  }

  .empty-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #294C60;
    margin-bottom: 12rpx;
  }

  .empty-desc {
    font-size: 25rpx;
    line-height: 1.6;
  }

  .load-more {
    width: 240rpx;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    margin: 18rpx auto 150rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    color: #294C60;
    border: 1rpx solid #E5E1DA;
    font-size: 25rpx;
    font-weight: 700;
  }
  
  .bottom-actions {
    position: fixed;
    left: 32rpx;
    right: 32rpx;
    bottom: 72rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 20;
  }
  
  .timeline-float-btn {
    width: 300rpx;
    height: 104rpx;
    padding: 0 32rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    color: #294C60;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14rpx;
    box-shadow: 0 14rpx 32rpx rgba(41, 76, 96, 0.16);
    box-sizing: border-box;
  }
  
  .btn-icon {
    font-size: 36rpx;
    line-height: 1;
  }
  
  .btn-text {
    font-size: 30rpx;
    font-weight: 800;
  }
  
  .add-float-btn {
    width: 112rpx;
    height: 112rpx;
    border-radius: 50%;
    background: #294C60;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 14rpx 32rpx rgba(41, 76, 96, 0.28);
  }
  
  .add-icon {
    font-size: 58rpx;
    line-height: 1;
    margin-top: -4rpx;
  }