<view class="container">

<view class="header">
  <view>
    <view class="page-title">迹录册</view>
    <view class="page-subtitle">经历归档</view>
  </view>
  <view class="header-actions">
    <view class="merge-export-entry" bindtap="goMergeExport">合并导出</view>
    <view class="more" bindtap="openMoreMenu">•••</view>
  </view>
</view>

<view class="search-box">
  <text class="search-icon">⌕</text>
  <input
    placeholder="搜索活动、地点、角色或证明材料"
    value="{{keyword}}"
    bindinput="onSearchInput"
  />
</view>

<view class="search-export-row" wx:if="{{keyword}}">
  <view class="search-export-text">当前搜索结果 {{filteredRecords.length}} 条</view>
  <view class="search-export-btn {{isGenerating ? 'disabled' : ''}}" bindtap="exportSearchResults">导出当前搜索结果</view>
</view>

<view class="filter-row">
  <view
    wx:for="{{filters}}"
    wx:key="*this"
    class="filter {{currentFilter === item ? 'active' : ''}}"
    bindtap="changeFilter"
    data-name="{{item}}"
  >
    {{item}}
  </view>
</view>

<view class="month-title" wx:if="{{records.length > 0 || allRecords.length === 0}}">
  我的记录
</view>

<view
  wx:for="{{records}}"
  wx:key="id"
  class="record-card"
  bindtap="goDetail"
  data-id="{{item.id}}"
>
  <view class="cover-wrap">
    <image
      wx:if="{{item.coverDisplay}}"
      class="cover"
      src="{{item.coverDisplay}}"
      mode="aspectFill"
    />
    <view wx:else class="cover-placeholder">
      <text>暂无图片</text>
    </view>

    <view class="photo-count" wx:if="{{item.photoCount}}">
      {{item.photoCount}}张
    </view>
  </view>

  <view class="record-body">
    <view class="record-title-row">
      <view class="record-title">{{item.title}}</view>
      <view class="privacy-badge" wx:if="{{item.isPrivate}}">私密</view>
    </view>
    <view class="record-meta">{{item.dateRangeText}}｜{{item.category}}｜{{item.location}}</view>

    <view class="proof-row" wx:if="{{item.proofSummary && item.proofSummary.length > 0}}">
      <view
        wx:for="{{item.proofSummary}}"
        wx:key="name"
        class="proof-tag"
      >
        {{item.name}} {{item.count}}
      </view>
    </view>

    <view class="proof-row" wx:else>
      <view class="proof-tag empty-proof">暂无证明材料</view>
    </view>
  </view>
</view>

<view class="load-more" wx:if="{{hasMore}}" bindtap="loadMoreRecords">加载更多</view>

<view class="empty-guide" wx:if="{{allRecords.length === 0}}">
  <view class="empty-guide-title">先记录一段值得保留的经历</view>
  <view class="empty-guide-desc">项目、活动、实习、旅行或申请材料，都可以整理成可导出的档案。</view>

  <view class="onboarding-tag-row">
    <view wx:for="{{onboardingTags}}" wx:key="*this" class="onboarding-tag">{{item}}</view>
  </view>

  <view class="empty-guide-actions">
    <view class="primary-guide-btn" bindtap="goAdd">创建第一条经历</view>
    <view class="secondary-guide-btn" bindtap="showExampleRecord">查看示例</view>
  </view>
</view>

<view class="example-card" wx:if="{{allRecords.length === 0 && showExample}}">
  <view class="example-card-head">
    <view>
      <view class="example-title">社区环保活动记录</view>
      <view class="example-subtitle">示例记录不会写入数据库</view>
    </view>
    <view class="example-close" bindtap="hideExampleRecord">×</view>
  </view>

  <view class="example-material-grid">
    <view class="example-material-item">
      <image class="example-material-img" src="/images/onboarding/example-community-photo.svg" mode="aspectFill" />
      <view class="example-material-caption">现场照片</view>
    </view>
    <view class="example-material-item">
      <image class="example-material-img" src="/images/onboarding/example-community-poster.svg" mode="aspectFill" />
      <view class="example-material-caption">活动通知</view>
    </view>
    <view class="example-material-item">
      <image class="example-material-img" src="/images/onboarding/example-community-signin.svg" mode="aspectFill" />
      <view class="example-material-caption">签到记录</view>
    </view>
  </view>

  <view class="example-row">
    <text class="example-label">分类</text>
    <text class="example-value">活动 / 项目</text>
  </view>
  <view class="example-row">
    <text class="example-label">地点</text>
    <text class="example-value">城市公园</text>
  </view>
  <view class="example-row">
    <text class="example-label">身份 / 角色</text>
    <text class="example-value">参与者 / 组织协助</text>
  </view>
  <view class="example-row">
    <text class="example-label">材料</text>
    <text class="example-value">现场照片、活动通知、签到记录</text>
  </view>
  <view class="example-note">记录活动过程、个人参与内容和后续可复盘的材料。</view>

  <view class="example-actions">
    <view class="example-primary-btn" bindtap="goAddFromExample">参考示例创建</view>
    <view class="example-secondary-btn" bindtap="goAdd">创建自己的经历</view>
  </view>
</view>

<view class="empty" wx:if="{{allRecords.length > 0 && records.length === 0}}">
  <view class="empty-title">暂无符合条件的记录</view>
  <view class="empty-desc">
    可以换个关键词或分类再试试
  </view>
</view>

<view class="bottom-actions">
  <view class="timeline-float-btn" bindtap="goTimeline">
    <view class="btn-icon">⏱</view>
    <view class="btn-text">查看时间轴</view>
  </view>

  <view class="add-float-btn" bindtap="goAdd">
    <view class="add-icon">＋</view>
  </view>
</view>

</view>