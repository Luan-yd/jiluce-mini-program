page {
  background: #f7f3ea;
  color: #263238;
}

.onboarding-page {
  min-height: 100vh;
  padding: 64rpx 32rpx 70rpx;
  box-sizing: border-box;
  background: #f7f3ea;
  display: flex;
  flex-direction: column;
}

.brand-block {
  padding: 20rpx 12rpx 36rpx;
}

.brand-title {
  font-size: 54rpx;
  font-weight: 800;
  color: #214f63;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: #8c8174;
  font-weight: 600;
}

.guide-panel {
  flex: 1;
  min-height: 760rpx;
  padding: 58rpx 36rpx 44rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e5e1da;
  box-shadow: 0 14rpx 34rpx rgba(79, 63, 42, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.guide-icon {
  position: relative;
  width: 178rpx;
  height: 156rpx;
  margin: 0 auto 48rpx;
}

.archive-box {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  width: 138rpx;
  height: 94rpx;
  border-radius: 18rpx 18rpx 22rpx 22rpx;
  background: #28566b;
  box-shadow: 0 10rpx 20rpx rgba(40, 86, 107, 0.16);
}

.box-label {
  position: absolute;
  left: 42rpx;
  top: 36rpx;
  width: 50rpx;
  height: 18rpx;
  border-radius: 6rpx;
  background: #f3dfb8;
}

.paper {
  position: absolute;
  width: 86rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #fffaf0;
  box-shadow: 0 6rpx 14rpx rgba(77, 59, 36, 0.1);
}

.paper-one {
  right: 30rpx;
  top: 0;
  transform: rotate(-6deg);
}

.paper-two {
  right: 58rpx;
  top: 18rpx;
  transform: rotate(8deg);
  opacity: 0.9;
}

.guide-title {
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #28566b;
  text-align: center;
}

.guide-desc {
  margin: 18rpx auto 0;
  max-width: 560rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a8178;
  text-align: center;
}

.onboarding-tag-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin-top: 34rpx;
}

.onboarding-tag {
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: #f7f5ef;
  border: 1rpx solid #e5e1da;
  color: #5f5a52;
  font-size: 24rpx;
}

.guide-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 44rpx;
}

.primary-guide-btn,
.secondary-guide-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.primary-guide-btn {
  background: #28566b;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(40, 86, 107, 0.18);
}

.secondary-guide-btn {
  background: #ffffff;
  color: #28566b;
  border: 1rpx solid #e5e1da;
}

.safe-banner {
  margin-top: 28rpx;
  min-height: 68rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #f8ead8;
  color: #7b6245;
  font-size: 23rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.safe-icon {
  flex-shrink: 0;
  font-weight: 700;
}