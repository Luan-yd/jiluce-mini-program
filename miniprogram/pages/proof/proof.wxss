.proof-page {
    min-height: 100vh;
    background: #F8F6F1;
    padding-bottom: 80rpx;
    box-sizing: border-box;
  }
  
  .top-nav {
    padding: 28rpx 32rpx 20rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .back {
    font-size: 28rpx;
    color: #294C60;
  }
  
  .nav-title {
    font-size: 34rpx;
    font-weight: 800;
    color: #202124;
  }
  
  .nav-placeholder {
    width: 88rpx;
  }
  
  .proof-card {
    margin: 16rpx 32rpx 32rpx;
    background: #FFFFFF;
    border-radius: 36rpx;
    padding: 36rpx;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 12rpx 36rpx rgba(41, 76, 96, 0.08);
    box-sizing: border-box;
  }
  
  .brand-row {
    display: flex;
    align-items: center;
    margin-bottom: 36rpx;
  }
  
  .logo-box {
    width: 72rpx;
    height: 72rpx;
    border-radius: 20rpx;
    display: block;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .brand-title {
    font-size: 32rpx;
    font-weight: 800;
    color: #202124;
  }
  
  .brand-subtitle {
    font-size: 23rpx;
    color: #77746E;
    margin-top: 4rpx;
  }
  
  .main-title {
    font-size: 42rpx;
    font-weight: 900;
    color: #202124;
    line-height: 1.4;
    margin-bottom: 32rpx;
  }
  
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18rpx;
    margin-bottom: 34rpx;
  }
  
  .meta-item {
    background: #F8F6F1;
    border: 1rpx solid #E5E1DA;
    border-radius: 22rpx;
    padding: 20rpx;
    box-sizing: border-box;
  }
  
  .meta-label {
    font-size: 22rpx;
    color: #77746E;
    margin-bottom: 8rpx;
  }
  
  .meta-value {
    font-size: 26rpx;
    color: #202124;
    font-weight: 700;
    line-height: 1.4;
  }
  
  .section {
    margin-top: 34rpx;
  }
  
  .section-title {
    font-size: 30rpx;
    font-weight: 800;
    color: #294C60;
    margin-bottom: 16rpx;
  }
  
  .description {
    background: #F8F6F1;
    border: 1rpx solid #E5E1DA;
    border-radius: 22rpx;
    padding: 24rpx;
    font-size: 27rpx;
    line-height: 1.7;
    color: #202124;
  }
  
  .tag-row,
  .summary-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
  }
  
  .tag {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #E9DED0;
    color: #7A4F2A;
    font-size: 23rpx;
    font-weight: 600;
  }
  
  .summary-tag {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #DDECE7;
    color: #294C60;
    font-size: 23rpx;
    font-weight: 700;
  }
  
  .summary-empty {
    font-size: 25rpx;
    color: #77746E;
  }
  
  .image-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18rpx;
  }
  
  .image-item {
    position: relative;
    height: 260rpx;
    border-radius: 22rpx;
    overflow: hidden;
    background: #F1F0EC;
  }
  
  .proof-img {
    width: 100%;
    height: 260rpx;
  }
  
  .img-type {
    position: absolute;
    left: 10rpx;
    bottom: 10rpx;
    background: rgba(32, 33, 36, 0.65);
    color: #FFFFFF;
    font-size: 20rpx;
    padding: 5rpx 12rpx;
    border-radius: 999rpx;
  }
  
  .footer-line {
    height: 1rpx;
    background: #E5E1DA;
    margin: 40rpx 0 22rpx;
  }
  
  .footer-text {
    font-size: 22rpx;
    color: #77746E;
    margin-bottom: 10rpx;
  }
  
  .footer-note {
    font-size: 21rpx;
    color: #99938A;
    line-height: 1.5;
  }
  
  .action-area {
    padding: 0 32rpx;
    display: flex;
    gap: 18rpx;
  }
  
  .save-btn {
    flex: 1;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 28rpx;
    background: #294C60;
    color: #FFFFFF;
    font-size: 30rpx;
    font-weight: 800;
    box-shadow: 0 14rpx 32rpx rgba(41, 76, 96, 0.24);
  }
  
  .tip-btn {
    width: 180rpx;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 28rpx;
    background: #FFFFFF;
    color: #294C60;
    border: 1rpx solid #E5E1DA;
    font-size: 28rpx;
    font-weight: 700;
  }
  
  .save-btn::after,
  .tip-btn::after {
    border: none;
  }
  
  .btn-word {
    margin: 12px 16px 0;
    background: #fff;
    color: #1a2a4a;
    border: 1px solid #1a2a4a;
    text-align: center;
    padding: 14px;
    border-radius: 10px;
    font-size: 15px;
  }
  
  .hidden-canvas {
    position: fixed;
    left: -9999px;
    top: -9999px;
    width: 750px;
    height: 6000px;
  }
  .action-area {
    display: flex;
    gap: 24rpx;
    padding: 32rpx;
    background: #f7f5ef;
  }
  
  .action-btn {
    flex: 1;
    height: 104rpx;
    line-height: 104rpx;
    border-radius: 28rpx;
    background: #28566b;
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 600;
    text-align: center;
    box-shadow: 0 16rpx 32rpx rgba(40, 86, 107, 0.22);
    border: none;
    padding: 0;
    margin: 0;
    white-space: nowrap;
  }
  
  .action-btn::after {
    border: none;
  }