.detail-page {
    min-height: 100vh;
    background: #F8F6F1;
    padding-bottom: 60rpx;
    box-sizing: border-box;
  }
  
  .top-nav {
    padding: 28rpx 32rpx 20rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .back {
    font-size: 28rpx;
    color: #294C60;
  }
  
  .nav-title {
    font-size: 34rpx;
    font-weight: 800;
    color: #202124;
  }
  
  .nav-placeholder {
    width: 88rpx;
  }
  
  .hero {
    width: 100%;
    height: 420rpx;
    background: #E5E1DA;
  }
  
  .hero-swiper {
    width: 100%;
    height: 420rpx;
  }
  
  .hero-img {
    width: 100%;
    height: 420rpx;
  }
  
  .hero-placeholder {
    width: 100%;
    height: 420rpx;
    background: #D8D3CA;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #77746E;
    font-size: 28rpx;
  }
  
  .content-card {
    margin: -36rpx 32rpx 0;
    background: #FFFFFF;
    border-radius: 32rpx;
    padding: 32rpx;
    position: relative;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 12rpx 36rpx rgba(41, 76, 96, 0.08);
    box-sizing: border-box;
  }
  
  .detail-title {
    font-size: 38rpx;
    font-weight: 800;
    color: #202124;
    line-height: 1.4;
    margin-bottom: 12rpx;
  }
  
  .detail-meta {
    font-size: 25rpx;
    color: #77746E;
    margin-bottom: 20rpx;
  }
  
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 30rpx;
  }
  
  .tag-green {
    background: #DDECE7;
    color: #294C60;
    border-radius: 999rpx;
    padding: 8rpx 18rpx;
    font-size: 23rpx;
  }
  
  .section-title {
    font-size: 30rpx;
    font-weight: 800;
    color: #202124;
    margin: 30rpx 0 18rpx;
  }
  
  .summary-box {
    background: #F8F6F1;
    border-radius: 24rpx;
    padding: 24rpx;
    border: 1rpx solid #E5E1DA;
    box-sizing: border-box;
  }
  
  .summary-row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 18rpx;
  }
  
  .summary-row:last-child {
    margin-bottom: 0;
  }
  
  .summary-label {
    width: 90rpx;
    color: #77746E;
    font-size: 25rpx;
    flex-shrink: 0;
  }
  
  .summary-value {
    flex: 1;
    color: #202124;
    font-size: 26rpx;
    line-height: 1.6;
  }
  
  .summary-material-value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: auto;
  }
  
  .proof-summary-text {
    display: inline;
    line-height: 1.6;
  }
  
  .material-tip {
    color: #999999;
    font-size: 24rpx;
    line-height: 1.5;
    margin: -8rpx 0 18rpx;
  }
  
  .material-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16rpx;
  }
  
  .material-item {
    position: relative;
    height: 190rpx;
    border-radius: 20rpx;
    overflow: hidden;
    background: #F1F0EC;
  }
  
  .material-img {
    width: 100%;
    height: 190rpx;
  }
  
  .material-type {
    position: absolute;
    left: 8rpx;
    bottom: 8rpx;
    background: rgba(32, 33, 36, 0.65);
    color: #FFFFFF;
    font-size: 18rpx;
    padding: 4rpx 8rpx;
    border-radius: 999rpx;
    max-width: 140rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  
  .export-btn {
    margin-top: 42rpx;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 28rpx;
    background: #294C60;
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 700;
    box-shadow: 0 16rpx 32rpx rgba(41, 76, 96, 0.22);
  }
  
  .export-btn::after {
    border: none;
  }
  .action-row {
    display: flex;
    gap: 16rpx;
    margin: 24rpx 0 28rpx;
  }
  
  .edit-btn,
  .delete-record-btn {
    flex: 1;
    height: 76rpx;
    line-height: 76rpx;
    border-radius: 22rpx;
    font-size: 26rpx;
    font-weight: 700;
  }
  
  .edit-btn {
    background: #DDECE7;
    color: #294C60;
  }
  
  .delete-record-btn {
    background: #F8E6E0;
    color: #A23B2A;
  }
  
  .edit-btn::after,
  .delete-record-btn::after {
    border: none;
  }