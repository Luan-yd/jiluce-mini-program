<view class="detail-page" wx:if="{{record}}">

<view class="top-nav">
  <view class="back-text" bindtap="goList">‹ 列表</view>
  <view class="nav-title">记录详情</view>
  <view class="nav-placeholder"></view>
</view>

<view class="hero">
  <swiper
    wx:if="{{record.files && record.files.length > 0}}"
    class="hero-swiper"
    indicator-dots="{{record.files.length > 1}}"
    circular="{{record.files.length > 1}}"
  >
    <swiper-item
      wx:for="{{record.files}}"
      wx:key="id"
      bindtap="previewHeroImage"
      data-index="{{index}}"
    >
      <image
        class="hero-img"
        src="{{item.path}}"
        mode="aspectFill"
        binderror="onImageError"
      />
    </swiper-item>
  </swiper>
  <view wx:else class="hero-placeholder">
    <text>暂无封面</text>
  </view>
</view>

<view class="content-card">
  <view class="detail-title-row">
    <view class="detail-title">{{record.title}}</view>
    <view class="privacy-badge" wx:if="{{record.isPrivate}}">私密</view>
  </view>
  <view class="detail-meta">{{record.dateRangeText}}｜{{record.category}}｜{{record.location}}</view>

<view class="action-row">
  <button class="edit-btn" bindtap="editRecord">编辑记录</button>
  <button class="delete-record-btn" bindtap="deleteRecord">删除记录</button>
</view>

  <view class="tag-row">
    <view
      wx:for="{{record.tags}}"
      wx:key="*this"
      class="tag-green"
    >
      {{item}}
    </view>
  </view>

  <view class="section-title">证明摘要</view>

  <view class="summary-box">
    <view class="summary-row">
      <text class="summary-label">身份</text>
      <text class="summary-value">{{record.role}}</text>
    </view>

    <view class="summary-row">
      <text class="summary-label">材料</text>
      <view class="summary-value summary-material-value">
        <block wx:if="{{record.proofSummary && record.proofSummary.length > 0}}">
          <text
            wx:for="{{record.proofSummary}}"
            wx:key="name"
            class="proof-summary-text"
          >{{item.name}}{{item.count}}份{{index < record.proofSummary.length - 1 ? '，' : ''}}</text>
        </block>
        <text wx:else>暂无材料</text>
      </view>
    </view>

    <view class="summary-row">
      <text class="summary-label">备注</text>
      <text class="summary-value">{{record.description}}</text>
    </view>
  </view>

  <view class="section-title">材料</view>
  <view class="material-tip">如需新增、删除或修改材料，请点击“编辑记录”。</view>

  <view class="material-grid" wx:if="{{record.files && record.files.length > 0}}">
    <view
      wx:for="{{record.files}}"
      wx:key="id"
      class="material-item"
      bindtap="previewImage"
      data-index="{{index}}"
    >
      <image class="material-img" src="{{item.path}}" mode="aspectFill" binderror="onImageError" />
      <view class="material-type">{{item.type}}</view>
    </view>
  </view>
  <view wx:else class="material-tip">暂无可显示图片</view>

  <button class="export-btn" bindtap="generateProof">
    生成资料包
  </button>
</view>

</view>