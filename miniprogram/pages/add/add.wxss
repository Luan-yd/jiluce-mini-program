.top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28rpx;
  }
  
  .back {
    font-size: 28rpx;
    color: #294C60;
  }
  
  .nav-title {
    font-size: 34rpx;
    font-weight: 800;
    color: #202124;
  }
  
  .nav-placeholder {
    width: 88rpx;
  }
  
  .step-text {
    font-size: 26rpx;
    color: #294C60;
    font-weight: 700;
    margin-bottom: 20rpx;
  }
  
  .space-top {
    margin-top: 36rpx;
  }
  
  .form-card {
    background: #FFFFFF;
    border-radius: 24rpx;
    border: 1rpx solid #E5E1DA;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-sizing: border-box;
  }
  
  .input-label {
    font-size: 24rpx;
    color: #77746E;
    margin-bottom: 12rpx;
  }
  
  .input {
    width: 100%;
    font-size: 30rpx;
    color: #202124;
    height: 52rpx;
  }
  
  .textarea {
    width: 100%;
    min-height: 54rpx;
    font-size: 28rpx;
    color: #202124;
    line-height: 1.6;
  }
  
  .picker-value {
    font-size: 30rpx;
    color: #202124;
    min-height: 52rpx;
    line-height: 52rpx;
  }
  
  .placeholder {
    color: #B3ADA3;
  }
  
  .section-title {
    font-size: 28rpx;
    color: #202124;
    font-weight: 700;
    margin: 28rpx 0 18rpx;
  }

  .section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20rpx;
    margin: 28rpx 0 18rpx;
  }

  .compact-title {
    margin: 0;
  }

  .proof-title-row {
    margin-top: 0;
  }

  .manage-add {
    color: #294C60;
    font-size: 24rpx;
    font-weight: 700;
    flex-shrink: 0;
  }
  
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-bottom: 24rpx;
  }
  
  .chip {
    padding: 14rpx 26rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    color: #555555;
    font-size: 25rpx;
  }

  .editable-chip {
    display: inline-flex;
    align-items: center;
    gap: 10rpx;
    padding-right: 14rpx;
  }

  .chip-text {
    max-width: 180rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .chip-delete {
    width: 34rpx;
    height: 34rpx;
    line-height: 30rpx;
    text-align: center;
    border-radius: 50%;
    background: rgba(32, 33, 36, 0.12);
    color: #77746E;
    font-size: 26rpx;
    flex-shrink: 0;
  }
  
  .chip.active {
    background: #294C60;
    border-color: #294C60;
    color: #FFFFFF;
  }

  .chip.active .chip-delete {
    background: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
  }

  .empty-tip {
    color: #999999;
    font-size: 24rpx;
    line-height: 1.5;
    margin: -8rpx 0 24rpx;
  }

  .proof-empty-tip {
    margin-top: -12rpx;
  }
  
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16rpx;
    margin-bottom: 24rpx;
  }
  
  .proof-type {
    min-height: 92rpx;
    border-radius: 22rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    color: #555555;
    font-size: 23rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10rpx;
    box-sizing: border-box;
  }

  .editable-proof-type {
    position: relative;
    padding: 18rpx 26rpx 12rpx 12rpx;
  }

  .proof-type-text {
    max-width: 100%;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .proof-delete {
    position: absolute;
    right: 6rpx;
    top: 6rpx;
    width: 30rpx;
    height: 30rpx;
    line-height: 26rpx;
    text-align: center;
    border-radius: 50%;
    background: rgba(32, 33, 36, 0.12);
    color: #77746E;
    font-size: 24rpx;
  }
  
  .proof-type.active {
    background: #DDECE7;
    color: #294C60;
    border-color: #294C60;
    font-weight: 700;
  }

  .proof-type.active .proof-delete {
    background: rgba(41, 76, 96, 0.14);
    color: #294C60;
  }
  
  .upload-section {
    margin-top: 20rpx;
  }
  
  .upload-title {
    font-size: 26rpx;
    color: #77746E;
    margin-bottom: 8rpx;
  }
  
  .cover-tip {
    color: #999999;
    font-size: 23rpx;
    line-height: 1.5;
    margin-bottom: 16rpx;
  }
  
  .upload-row {
    display: flex;
    gap: 16rpx;
    margin-bottom: 28rpx;
    flex-wrap: wrap;
  }
  
  .upload-img-wrap,
  .upload-box {
    position: relative;
    width: 150rpx;
    height: 150rpx;
    border-radius: 20rpx;
    overflow: hidden;
  }
  
  .upload-img {
    width: 150rpx;
    height: 150rpx;
  }
  
  .upload-box {
    border: 2rpx dashed #C9C3B8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #FDFCF8;
    color: #77746E;
    box-sizing: border-box;
  }
  
  .plus {
    font-size: 42rpx;
    color: #294C60;
    line-height: 1;
  }
  
  .upload-text {
    font-size: 22rpx;
    margin-top: 8rpx;
  }
  
  .file-type {
    position: absolute;
    left: 6rpx;
    bottom: 6rpx;
    background: rgba(32, 33, 36, 0.65);
    color: #FFFFFF;
    font-size: 18rpx;
    padding: 4rpx 8rpx;
    border-radius: 999rpx;
    max-width: 120rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  
  .delete-btn {
    position: absolute;
    right: 6rpx;
    top: 6rpx;
    width: 34rpx;
    height: 34rpx;
    line-height: 30rpx;
    text-align: center;
    border-radius: 50%;
    background: rgba(32, 33, 36, 0.7);
    color: #FFFFFF;
    font-size: 28rpx;
    z-index: 2;
  }
  
  .privacy-item {
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    border-radius: 22rpx;
    padding: 24rpx;
    margin-bottom: 16rpx;
    font-size: 26rpx;
    color: #202124;
    box-sizing: border-box;
  }
  
  .privacy-item text {
    margin-left: 12rpx;
  }
  
  .save-btn {
    margin-top: 40rpx;
    margin-bottom: 60rpx;
    width: 100%;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 28rpx;
    background: #294C60;
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 700;
    box-shadow: 0 16rpx 32rpx rgba(41, 76, 96, 0.22);
  }
  
  .save-btn::after {
    border: none;
  }