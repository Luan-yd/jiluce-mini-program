.welcome-page {
    min-height: 100vh;
    background: #F8F6F1;
    padding: 80rpx 48rpx 48rpx;
    box-sizing: border-box;
  }
  
  .top-area {
    text-align: center;
    margin-top: 40rpx;
    margin-bottom: 56rpx;
  }
  
  .logo-box {
    position: relative;
    width: 128rpx;
    height: 128rpx;
    border-radius: 32rpx;
    background: #294C60;
    margin: 0 auto 28rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 16rpx 36rpx rgba(41, 76, 96, 0.22);
  }

  .logo-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 128rpx;
    height: 128rpx;
    display: block;
    z-index: 2;
  }
  
  .logo-text {
    color: #FFFFFF;
    font-size: 56rpx;
    font-weight: 700;
  }
  
  .title {
    font-size: 56rpx;
    font-weight: 800;
    color: #202124;
    letter-spacing: 2rpx;
  }
  
  .subtitle {
    font-size: 30rpx;
    color: #77746E;
    margin-top: 12rpx;
  }
  
  .slogan {
    margin: 48rpx auto 0;
    max-width: 520rpx;
    font-size: 32rpx;
    line-height: 1.7;
    color: #294C60;
    font-weight: 500;
  }
  
  .feature-card {
    background: #FFFFFF;
    border-radius: 36rpx;
    padding: 36rpx 32rpx;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 12rpx 36rpx rgba(41, 76, 96, 0.08);
  }
  
  .feature-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 34rpx;
  }
  
  .feature-item:last-child {
    margin-bottom: 0;
  }
  
  .icon {
    width: 56rpx;
    height: 56rpx;
    min-width: 56rpx;
    border-radius: 18rpx;
    background: #DDECE7;
    color: #294C60;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30rpx;
    margin-right: 22rpx;
    font-weight: 700;
  }
  
  .feature-title {
    font-size: 30rpx;
    color: #202124;
    font-weight: 700;
    margin-bottom: 8rpx;
  }
  
  .feature-desc {
    font-size: 25rpx;
    color: #77746E;
    line-height: 1.5;
  }
  
  .start-btn {
    margin-top: 56rpx;
    height: 96rpx;
    line-height: 96rpx;
    border-radius: 28rpx;
    background: #294C60;
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 700;
    box-shadow: 0 16rpx 32rpx rgba(41, 76, 96, 0.22);
  }
  
  .start-btn::after {
    border: none;
  }
  
  .bottom-text {
    margin-top: 32rpx;
    text-align: center;
    color: #77746E;
    font-size: 24rpx;
    line-height: 1.6;
  }