.timeline-page {
    min-height: 100vh;
    background: #F8F6F1;
    padding: 32rpx;
    padding-bottom: 120rpx;
    box-sizing: border-box;
  }
  
  .top-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28rpx;
  }
  
  .page-title {
    font-size: 44rpx;
    font-weight: 800;
    color: #202124;
  }
  
  .page-subtitle {
    font-size: 26rpx;
    color: #77746E;
    margin-top: 8rpx;
  }
  
  .home-btn {
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    border: 1rpx solid #E5E1DA;
    color: #294C60;
    font-size: 24rpx;
    font-weight: 700;
  }

  .filter-panel {
    background: #FFFFFF;
    border-radius: 24rpx;
    border: 1rpx solid #E5E1DA;
    padding: 22rpx;
    margin-bottom: 34rpx;
    box-sizing: border-box;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14rpx;
  }

  .filter {
    padding: 10rpx 20rpx;
    border-radius: 999rpx;
    background: #F8F6F1;
    color: #555555;
    font-size: 23rpx;
    border: 1rpx solid #E5E1DA;
  }

  .filter.active {
    background: #294C60;
    color: #FFFFFF;
    border-color: #294C60;
    font-weight: 700;
  }

  .custom-row {
    display: flex;
    align-items: center;
    gap: 14rpx;
    margin-top: 18rpx;
  }

  .date-picker {
    min-width: 210rpx;
    height: 68rpx;
    line-height: 68rpx;
    padding: 0 20rpx;
    border-radius: 18rpx;
    background: #F8F6F1;
    border: 1rpx solid #E5E1DA;
    color: #202124;
    font-size: 24rpx;
    box-sizing: border-box;
  }

  .date-picker.placeholder {
    color: #999999;
  }

  .date-separator {
    color: #77746E;
    font-size: 24rpx;
  }
  
  .month-group {
    margin-bottom: 44rpx;
  }
  
  .month-title {
    font-size: 32rpx;
    font-weight: 800;
    color: #294C60;
    margin-bottom: 24rpx;
  }
  
  .month-line {
    position: relative;
    padding-left: 30rpx;
  }
  
  .month-line::before {
    content: '';
    position: absolute;
    left: 9rpx;
    top: 8rpx;
    bottom: 8rpx;
    width: 2rpx;
    background: #D8D3CA;
  }
  
  .timeline-item {
    position: relative;
    margin-bottom: 28rpx;
  }
  
  .dot {
    position: absolute;
    left: -30rpx;
    top: 28rpx;
    width: 18rpx;
    height: 18rpx;
    border-radius: 50%;
    background: #294C60;
    border: 6rpx solid #DDECE7;
    z-index: 2;
  }
  
  .timeline-card {
    background: #FFFFFF;
    border-radius: 28rpx;
    padding: 26rpx;
    border: 1rpx solid #E5E1DA;
    box-shadow: 0 8rpx 24rpx rgba(41, 76, 96, 0.06);
    box-sizing: border-box;
  }
  
  .card-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20rpx;
  }

  .record-title-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .record-title {
    font-size: 30rpx;
    font-weight: 800;
    color: #202124;
    line-height: 1.4;
  }

  .privacy-badge {
    flex-shrink: 0;
    padding: 5rpx 12rpx;
    border-radius: 999rpx;
    background: #F8E6E0;
    color: #A23B2A;
    font-size: 20rpx;
    font-weight: 700;
  }
  
  .record-meta {
    font-size: 24rpx;
    color: #77746E;
    margin-top: 8rpx;
  }
  
  .record-type {
    flex-shrink: 0;
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    background: #DDECE7;
    color: #294C60;
    font-size: 22rpx;
    font-weight: 700;
  }
  
  .record-desc {
    margin-top: 18rpx;
    font-size: 25rpx;
    color: #555555;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .tag-row,
  .proof-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-top: 18rpx;
  }
  
  .small-tag {
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    background: #E9DED0;
    color: #7A4F2A;
    font-size: 21rpx;
  }
  
  .proof-tag {
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    background: #F1F0EC;
    color: #77746E;
    font-size: 21rpx;
  }
  
  .cover-row {
    margin-top: 20rpx;
  }
  
  .cover-img {
    width: 100%;
    height: 220rpx;
    border-radius: 20rpx;
    background: #F1F0EC;
  }

  .load-more {
    width: 240rpx;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    margin: 10rpx auto 36rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    color: #294C60;
    border: 1rpx solid #E5E1DA;
    font-size: 25rpx;
    font-weight: 700;
  }
  
  .empty {
    margin-top: 150rpx;
    text-align: center;
  }
  
  .empty-title {
    font-size: 32rpx;
    font-weight: 800;
    color: #202124;
    margin-bottom: 12rpx;
  }
  
  .empty-desc {
    font-size: 25rpx;
    color: #77746E;
    line-height: 1.6;
    margin-bottom: 36rpx;
  }
  
  .empty-btn {
    width: 300rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 24rpx;
    background: #294C60;
    color: #FFFFFF;
    font-size: 28rpx;
    font-weight: 700;
  }
  
  .empty-btn::after {
    border: none;
  }
  
  .float-btn {
    position: fixed;
    right: 40rpx;
    bottom: 72rpx;
    width: 104rpx;
    height: 104rpx;
    line-height: 104rpx;
    text-align: center;
    background: #294C60;
    color: #FFFFFF;
    font-size: 52rpx;
    border-radius: 50%;
    box-shadow: 0 12rpx 28rpx rgba(41, 76, 96, 0.25);
  }