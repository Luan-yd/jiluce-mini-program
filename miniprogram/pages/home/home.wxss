page {
  background: #f7f3ea;
  color: #263238;
}

.page {
  min-height: 100vh;
  padding: 72rpx 32rpx 180rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fbf8f0 0%, #f5efe5 100%);
}

.top-area {
  padding: 24rpx 12rpx 20rpx;
}

.title {
  font-size: 60rpx;
  font-weight: 800;
  color: #214f63;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.slogan {
  font-size: 32rpx;
  color: #4f4a43;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.sub-slogan {
  font-size: 25rpx;
  color: #8c8174;
  line-height: 1.5;
  width: 620rpx;
}

.summary-card {
  position: relative;
  margin-top: 30rpx;
  padding: 42rpx 38rpx 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #f5ecdc 100%);
  box-shadow: 0 18rpx 42rpx rgba(79, 63, 42, 0.12);
  overflow: hidden;
}

.summary-left {
  display: flex;
  align-items: center;
  width: 430rpx;
}

.stat-block {
  flex: 1;
}

.stat-icon {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(197, 162, 92, 0.16);
  color: #9c7a36;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.stat-label {
  font-size: 25rpx;
  color: #6d6257;
  margin-bottom: 8rpx;
}

.stat-number {
  font-size: 82rpx;
  line-height: 1;
  color: #214f63;
  font-weight: 800;
}

.stat-unit {
  font-size: 25rpx;
  color: #4f4a43;
  margin-top: 8rpx;
}

.divider {
  width: 1rpx;
  height: 120rpx;
  background: rgba(92, 77, 58, 0.16);
  margin: 0 34rpx;
}

.archive-illustration {
  position: absolute;
  right: 36rpx;
  top: 70rpx;
  width: 190rpx;
  height: 180rpx;
}

.archive-box {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 150rpx;
  height: 110rpx;
  border-radius: 18rpx 18rpx 22rpx 22rpx;
  background: #28566b;
  box-shadow: 0 12rpx 24rpx rgba(40, 86, 107, 0.18);
}

.box-label {
  position: absolute;
  left: 48rpx;
  top: 42rpx;
  width: 52rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: #f3dfb8;
}

.paper {
  position: absolute;
  width: 96rpx;
  height: 112rpx;
  border-radius: 10rpx;
  background: #fffaf0;
  box-shadow: 0 8rpx 18rpx rgba(77, 59, 36, 0.12);
}

.paper-one {
  right: 32rpx;
  top: 8rpx;
  transform: rotate(-6deg);
}

.paper-two {
  right: 60rpx;
  top: 26rpx;
  transform: rotate(8deg);
  opacity: 0.9;
}

.latest-row {
  margin-top: 34rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(112, 94, 67, 0.1);
  font-size: 26rpx;
  color: #7a6653;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.clock {
  color: #9a7b43;
}

.add-btn {
  margin-top: 34rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: #28566b;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 32rpx rgba(40, 86, 107, 0.22);
}

.add-btn::after {
  border: none;
}

.category-panel {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 28rpx rgba(88, 74, 52, 0.08);
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
}

.category-card {
  min-height: 124rpx;
  border-radius: 20rpx;
  background: #f7f5ef;
  text-align: center;
  padding: 14rpx 0 10rpx;
  box-sizing: border-box;
}

.category-icon {
  font-size: 32rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.category-name {
  font-size: 22rpx;
  color: #4d4a45;
  margin-top: 8rpx;
}

.category-count {
  font-size: 30rpx;
  color: #214f63;
  font-weight: 800;
  margin-top: 4rpx;
}

.section-title-row {
  margin: 42rpx 4rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #252525;
}

.view-all {
  font-size: 25rpx;
  color: #8a8178;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  height: 136rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 24rpx rgba(78, 65, 44, 0.06);
  box-sizing: border-box;
}

.record-cover {
  width: 146rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #e9e1d5;
  flex-shrink: 0;
}

.empty-cover {
  display: flex;
  justify-content: center;
  align-items: center;
  color: #28566b;
  font-size: 24rpx;
  font-weight: 700;
}

.record-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.record-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a8178;
}

.material-badge {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: #eaf2f8;
  color: #28566b;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}

.arrow {
  margin-left: 14rpx;
  font-size: 44rpx;
  color: #b1aba4;
}

.empty-card {
  padding: 46rpx 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  text-align: center;
  color: #8a8178;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #28566b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 25rpx;
  line-height: 1.6;
}

.safe-banner {
  margin-top: 28rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f8ead8;
  color: #7b6245;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.safe-icon {
  font-weight: 700;
}

.safe-arrow {
  margin-left: auto;
  font-size: 34rpx;
}